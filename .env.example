# Neon connection string, from the Neon console. Use the POOLED one.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Signs session tokens. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out. Never commit the real value.
AUTH_SECRET="replace-me-with-a-long-random-string"
